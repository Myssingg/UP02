<Window x:Class="UP02Project.Windows.OrderList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02Project.Windows"
        mc:Ignorable="d"
        Title="Список заказов" Height="450" Width="900"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="1" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="1*" x:Name="columnAddOrder"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnLogout" Content="Выйти" Grid.Column="0" Margin="5" Click="btnLogout_Click"/>

                <TextBlock x:Name="userRole" Padding="5" Grid.Column="1" Text="DefaultRole" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="userFIO" Padding="5" Grid.Column="2" Text="Иванов Иван Иванович" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button x:Name="btnAddOrder" Content="Добавить" Grid.Column="3" Margin="5" Click="btnAddOrder_Click" Background="#ABCFCE"/>
            </Grid>
        </Border>

        <ListView Grid.Row="1"
                  x:Name="items"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="items_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Padding="5"
                            Background="White">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="Артикул заказа: "/>
                                    <Run Text="{Binding Id}"/>
                                </TextBlock>

                                <TextBlock FontSize="12">
                                    <Run Text="Статус заказа: " Foreground="Gray"/>
                                    <Run Text="{Binding OrderStatus.StatusName}"/>
                                </TextBlock>

                                <TextBlock FontSize="12" TextWrapping="Wrap">
                                    <Run Text="Адрес пункта выдачи: " Foreground="Gray"/>
                                    <Run Text="{Binding Address, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock FontSize="12">
                                    <Run Text="Дата заказа: " Foreground="Gray"/>
                                    <Run Text="{Binding DateOrder, StringFormat={}{0:dd.MM.yyyy}, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Foreground="Gray" Text="Дата выдачи:"/>
                                <TextBlock FontSize="16" Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}, Mode=OneWay}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
