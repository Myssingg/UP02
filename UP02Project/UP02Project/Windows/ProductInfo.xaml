<Window x:Class="UP02Project.Windows.ProductInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02Project.Windows"
        mc:Ignorable="d"
        Title="Информация о товаре" Height="560" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Image Grid.Column="0"
               Grid.Row="0"
               Source="{Binding ImgPath}"
               Stretch="Uniform"
               Margin="15"/>

        <Button Content="Изменить изображение"
                Grid.Row="1"
                Grid.Column="0"
                Margin="15"
                x:Name="btnChangeImg"
                Click="btnChangeImg_Click"
                Height="40"/>

        <StackPanel Margin="10" Grid.Column="1" Grid.Row="0">
            <StackPanel x:Name="panelId">
                <TextBlock Text="Артикул"/>
                <TextBox IsReadOnly="True" x:Name="tbId" Text="{Binding Id}"/>
            </StackPanel>

            <TextBlock Text="Наименование"/>
            <TextBox x:Name="tbProductName" Text="{Binding ProductName}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Цена"/>
                    <TextBox x:Name="tbPrice" Text="{Binding Price}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Действующая скидка, %"/>
                    <TextBox x:Name="tbDiscount" Text="{Binding Discount}"/>
                </StackPanel>

            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Количество на складе"/>
                    <TextBox x:Name="tbStock" Text="{Binding Stock}"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Единица измерения" />
                    <ComboBox x:Name="cbUnitOfMeansurement" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              Grid.Row="1"/>
                </Grid>

            </Grid>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="tbDescription" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Категория"/>
                    <ComboBox x:Name="cbProductCategory" DisplayMemberPath="CategoryName"
                              Height="{Binding ActualHeight, ElementName=cbUnitOfMeansurement, Mode=OneWay}"
                              Grid.Row="1"/>
                </Grid>

                <Grid Margin="5,0,0,0" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Производитель"/>
                    <ComboBox x:Name="cbManufacturer" DisplayMemberPath="ManufacturerName"
                              Grid.Row="1"/>
                </Grid>
            </Grid>

            <TextBlock Text="Поставщик"/>
            <ComboBox x:Name="cbSupplier" DisplayMemberPath="SupplierName"
                      Height="{Binding ActualHeight, ElementName=cbManufacturer, Mode=OneWay}"
                      VerticalContentAlignment="Center"/>

        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Удалить товар"
                    Grid.Column="0"
                    x:Name="btnDelete"
                    Click="btnDelete_Click"
                    Height="40"
                    Width="180"/>

            <Button Content="Сохранить товар"
                    Grid.Column="2"
                    x:Name="btnSaveProduct"
                    Click="btnSaveProduct_Click"
                    Height="40"
                    Width="200"
                    Background="#ABCFCE"/>
        </Grid>

    </Grid>
</Window>
