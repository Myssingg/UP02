<Window x:Class="UP02Project.Windows.OrderInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02Project.Windows"
        mc:Ignorable="d"
        Title="ИнформацияОЗаказе" Height="420" Width="450">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Артикул заказа:"/>
            <TextBox x:Name="tbOrderId" Padding="4" IsReadOnly="True"/>
            <TextBlock x:Name="tbOrderIdHint" Text="Присваивается автоматически" FontSize="11" Foreground="Gray" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Статус заказа:"/>
            <ComboBox x:Name="cbOrderStatus" Padding="5"
                      DisplayMemberPath="StatusName" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Пункт выдачи:"/>
            <ComboBox x:Name="cbPickupPoint" Padding="5" SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Address}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Дата заказа:"/>
            <DatePicker x:Name="dpDateOrder"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="Дата выдачи:"/>
            <DatePicker x:Name="dpDeliveryDate"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnDelete" Content="Удалить" Grid.Column="0" Margin="5" Click="btnDelete_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" Grid.Column="2" Margin="5" Click="btnSave_Click" Background="#ABCFCE"/>
        </Grid>
    </Grid>
</Window>