<Window x:Class="UP02Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02Project"
        mc:Ignorable="d"
        Title="Авторизация" Height="440" Width="380">
    <StackPanel Orientation="Vertical" Margin="15">
        <!-- Логотип компании из ресурсов приложения -->
        <Image Source="/Images/logo.png"
               Height="110"
               Stretch="Uniform"
               Margin="0,0,0,15"/>

        <TextBlock Text="Логин"/>
        <TextBox x:Name="tbLogin" VerticalContentAlignment="Center"/>

        <TextBlock Text="Пароль" Margin="0,10,0,0"/>
        <PasswordBox x:Name="pbPassword" VerticalContentAlignment="Center"/>

        <Button x:Name="btnLogin" Margin="0,15,0,0" Content="Войти" Click="btnLogin_Click"/>

        <Button x:Name="btnWatchProducts" Margin="0,10,0,0" Content="Посмотреть список товаров" Click="btnWatchProducts_Click"/>
    </StackPanel>
</Window>
