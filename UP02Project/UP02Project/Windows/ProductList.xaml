<Window x:Class="UP02Project.Windows.ProductList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02Project.Windows"
        mc:Ignorable="d"
        Title="Список товаров" Height="650" Width="950"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="1" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" x:Name="columnAddProduct"/>
                    <ColumnDefinition Width="Auto" x:Name="columnToOrders"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnLogout" Content="Выйти" Grid.Column="0" Margin="5" Width="90" Click="btnLogout_Click"/>

                <TextBlock x:Name="userRole" Padding="10,0" Grid.Column="1" Text="DefaultRole" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <!-- ФИО авторизованного пользователя в правом верхнем углу -->
                <TextBlock x:Name="userFIO" Padding="10,0" Grid.Column="2" Text="Иванов Иван Иванович" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <Button x:Name="btnAddProduct" Content="Добавить" Grid.Column="3" Margin="5" Width="110" Click="btnAddProduct_Click" Background="#ABCFCE"/>

                <Button x:Name="btnToOrders" Content="К заказам" Grid.Column="4" Margin="5" Width="110" Click="btnToOrders_Click" Background="#ABCFCE"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" MaxHeight="55"/>
                <RowDefinition Height="auto" MaxHeight="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="filterPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Grid.Column="0" Margin="10,0">
                    <TextBlock Text="Поставщик"/>
                    <ComboBox x:Name="cbSuppliers" Padding="5" DisplayMemberPath="SupplierName" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Производитель"/>
                    <ComboBox x:Name="cbManufacturers" Padding="5" DisplayMemberPath="ManufacturerName" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Grid.Column="2" Margin="10,0">
                    <TextBlock Text="Категория"/>
                    <ComboBox x:Name="cbCategories" Padding="5" DisplayMemberPath="CategoryName" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>

                <Button x:Name="btnClearFilters" Content="Очистить" Grid.Column="3" Margin="7" VerticalAlignment="Bottom" Style="{StaticResource DefaultStyle}" Click="btnClearFilters_Click"/>
            </Grid>

            <Grid Grid.Row="1" x:Name="filterPanelAdministrator">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,0">
                    <TextBlock Text="Поиск (по всем данным товара):"/>
                    <TextBox x:Name="tbSearch" Padding="4" TextChanged="tbSearch_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Категория сортировки:"/>
                    <ComboBox x:Name="cbSortingCategory" Padding="5" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0">
                    <TextBlock Text="Тип сортировки:"/>
                    <ComboBox x:Name="cbSortingType" Padding="5" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="10,0">
                    <TextBlock Text="Действующая скидка:"/>
                    <ComboBox x:Name="cbActiveDiscount" Padding="5" SelectionChanged="cbFilters_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <ListView Grid.Row="2"
                      x:Name="items"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="items_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black"
                                BorderThickness="1"
                                Padding="5">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscontMoreThan25}" Value="True">
                                            <Setter Property="Background" Value="#23E1EF"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsProductAbsent}" Value="True">
                                            <Setter Property="Background" Value="#999999"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Width="120" Height="100"
                                       Source="{Binding ImgPath}"
                                       Stretch="Uniform"/>

                                <StackPanel Orientation="Vertical" Grid.Column="1">
                                    <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                                        <Run Text="{Binding Category.CategoryName}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding ProductName}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                        <Run Text="Описание товара: " Foreground="Gray"/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="12">
                                        <Run Text="Производитель: " Foreground="Gray"/>
                                        <Run Text="{Binding Manufacturer.ManufacturerName}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="12">
                                        <Run Text="Поставщик: " Foreground="Gray"/>
                                        <Run Text="{Binding Supplier.SupplierName}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="12" Text="Цена: " Foreground="Gray"/>
                                        <!-- Основная цена: красная и перечёркнутая, если действует скидка -->
                                        <TextBlock FontSize="12" Text="{Binding Price, StringFormat={}{0:N2} руб.}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Итоговая цена со скидкой показывается только при наличии скидки -->
                                        <TextBlock FontSize="12" FontWeight="Bold" Margin="8,0,0,0"
                                                   Text="{Binding DiscountPrice, StringFormat={}{0:N2} руб.}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock FontSize="12">
                                        <Run Text="Единица измерения: " Foreground="Gray"/>
                                        <Run Text="{Binding UnitOfMeansurement.Name}"/>
                                    </TextBlock>

                                    <TextBlock FontSize="12">
                                        <Run Text="Количество на складе: " Foreground="Gray"/>
                                        <Run Text="{Binding Stock}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Foreground="Gray" Text="Действующая скидка"/>
                                    <TextBlock FontSize="22" Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <TextBlock x:Name="tbEmptyList"
                       Grid.Row="2"
                       Text="Товаров не найдено"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
        </Grid>

    </Grid>
</Window>
